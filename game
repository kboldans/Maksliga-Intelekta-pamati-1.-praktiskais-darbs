import random
import time
import math
from dataclasses import dataclass, field
from typing import List, Optional, Tuple, Callable

import tkinter as tk
from tkinter import ttk, messagebox

HUMAN = 0
AI = 1

@dataclass(frozen=True)
class Move:
    divisor: int  # 2 or 3

    # 100 grami kulturas

@dataclass(frozen=True)
class GameState:
    n: int
    score_human: int
    score_ai: int
    player_to_move: int  # HUMAN or AI

    def legal_moves(self) -> List[Move]:
        moves = []
        if self.n % 2 == 0:
            moves.append(Move(2))
        if self.n % 3 == 0:
            moves.append(Move(3))
        return moves
    # def is_terminal(self):
    def is_terminal(self) -> bool:
        return self.n <= 10 or not self.legal_moves()

    def terminal_reason(self) -> Optional[str]:
        if self.n <= 10:
            return "number_reached"
        if not self.legal_moves():
            return "no_moves"
        return None
    
    def can_move(self) -> bool:
        return len(self.legal_moves()) > 0

    def apply(self, move: Move) -> "GameState":
        d = move.divisor
        if d not in (2, 3):
            raise ValueError("Invalid move divisor")
        if self.n % d != 0:
            raise ValueError("Illegal move (non-integer division)")

        new_n = self.n // d
        sh, sa = self.score_human, self.score_ai

        # Scoring rules:
        # divide by 2 -> opponent gets +2
        # divide by 3 -> current player gets +3
        if d == 2:
            if self.player_to_move == HUMAN:
                sa += 2
            else:
                sh += 2
        else:  # d == 3
            if self.player_to_move == HUMAN:
                sh += 3
            else:
                sa += 3

        next_player = AI if self.player_to_move == HUMAN else HUMAN
        return GameState(new_n, sh, sa, next_player)

    def winner(self) -> Optional[int]:
        """Return HUMAN / AI / None for draw, only valid when terminal."""
        if not self.is_terminal():
            return None
        if self.score_human == self.score_ai:
            return None
        return HUMAN if self.score_human > self.score_ai else AI


# -----------------------------
# Game tree node (required by assignment)
# -----------------------------

@dataclass
class Node:
    state: GameState
    move_from_parent: Optional[Move] = None
    parent: Optional["Node"] = None
    depth: int = 0
    value: Optional[float] = None
    children: List["Node"] = field(default_factory=list)


@dataclass
class SearchStats:
    generated_nodes: int = 0
    evaluated_nodes: int = 0


# -----------------------------
# Heuristic evaluation
# -----------------------------

def heuristic(state: GameState) -> float:
    """
    Evaluation from AI perspective: higher is better for AI.
    Depth-limited search needs heuristic for non-terminal nodes.

    Simple, explainable heuristic:
    - base: score difference (AI - human)
    - plus small term based on size of n (bigger n => more future moves possible)
    - plus mobility (number of legal moves for side to move) as a tiny tie-breaker
    """
    score_diff = state.score_ai - state.score_human

    # Estimate remaining "room": if n is large, more moves remain.
    # Use log so it doesn't dominate.
    room = 0.0 if state.n <= 10 else math.log(state.n / 10.0)

    # Mobility: prefer states where current mover has options
    mobility = len(state.legal_moves())

    # If it's AI to move, mobility is good; if human to move, mobility is slightly bad for AI
    mobility_term = 0.2 * mobility * (1 if state.player_to_move == AI else -1)

    return score_diff + 0.3 * room + mobility_term


def terminal_utility(state: GameState) -> float:
    """Hard utility for terminal positions, from AI perspective."""
    if state.score_ai > state.score_human:
        return 1_000_000.0 + (state.score_ai - state.score_human)
    if state.score_ai < state.score_human:
        return -1_000_000.0 - (state.score_human - state.score_ai)
    return 0.0


# -----------------------------
# Minimax / Alpha-Beta (depth-limited)
# Both build Node structure and track stats.
# -----------------------------

def minimax_decision(root_state: GameState, depth_limit: int) -> Tuple[Move, Node, SearchStats]:
    stats = SearchStats()
    root = Node(state=root_state, depth=0)

    def max_value(node: Node, depth: int) -> float:
        stats.generated_nodes += 1

        if node.state.is_terminal():
            stats.evaluated_nodes += 1
            v = terminal_utility(node.state)
            node.value = v
            return v
        if depth == 0:
            stats.evaluated_nodes += 1
            v = heuristic(node.state)
            node.value = v
            return v

        v = -float("inf")
        for mv in node.state.legal_moves():
            child_state = node.state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=node, depth=node.depth + 1)
            node.children.append(child)

            v = max(v, min_value(child, depth - 1))
        node.value = v
        return v

    def min_value(node: Node, depth: int) -> float:
        stats.generated_nodes += 1

        if node.state.is_terminal():
            stats.evaluated_nodes += 1
            v = terminal_utility(node.state)
            node.value = v
            return v
        if depth == 0:
            stats.evaluated_nodes += 1
            v = heuristic(node.state)
            node.value = v  
            return v

        v = float("inf")
        for mv in node.state.legal_moves():
            child_state = node.state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=node, depth=node.depth + 1)
            node.children.append(child)

            v = min(v, max_value(child, depth - 1))
        node.value = v
        return v

    # Decide best move for side-to-move:
    # If AI to move -> maximize; if HUMAN -> minimize (from AI perspective).
    best_move = None
    if root_state.player_to_move == AI:
        best_val = -float("inf")
        for mv in root_state.legal_moves():
            child_state = root_state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=root, depth=1)
            root.children.append(child)

            val = min_value(child, depth_limit - 1)
            if val > best_val:
                best_val = val
                best_move = mv
        root.value = best_val
    else:
        best_val = float("inf")
        for mv in root_state.legal_moves():
            child_state = root_state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=root, depth=1)
            root.children.append(child)

            val = max_value(child, depth_limit - 1)
            if val < best_val:
                best_val = val
                best_move = mv
        root.value = best_val

    if best_move is None:
        # No moves -> terminal anyway
        best_move = Move(2)

    return best_move, root, stats


def alphabeta_decision(root_state: GameState, depth_limit: int) -> Tuple[Move, Node, SearchStats]:
    stats = SearchStats()
    root = Node(state=root_state, depth=0)

    def max_value(node: Node, depth: int, alpha: float, beta: float) -> float:
        stats.generated_nodes += 1

        if node.state.is_terminal():
            stats.evaluated_nodes += 1
            v = terminal_utility(node.state)
            node.value = v
            return v
        if depth == 0:
            stats.evaluated_nodes += 1
            v = heuristic(node.state)
            node.value = v
            return v

        v = -float("inf")
        for mv in node.state.legal_moves():
            child_state = node.state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=node, depth=node.depth + 1)
            node.children.append(child)

            v = max(v, min_value(child, depth - 1, alpha, beta))
            if v >= beta:
                node.value = v
                return v
            alpha = max(alpha, v)
        node.value = v
        return v

    def min_value(node: Node, depth: int, alpha: float, beta: float) -> float:
        stats.generated_nodes += 1

        if node.state.is_terminal():
            stats.evaluated_nodes += 1
            v = terminal_utility(node.state)
            node.value = v
            return v
        if depth == 0:
            stats.evaluated_nodes += 1
            v = heuristic(node.state)
            node.value = v
            return v

        v = float("inf")
        for mv in node.state.legal_moves():
            child_state = node.state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=node, depth=node.depth + 1)
            node.children.append(child)

            v = min(v, max_value(child, depth - 1, alpha, beta))
            if v <= alpha:
                node.value = v
                return v
            beta = min(beta, v)
        node.value = v
        return v

    best_move = None
    if root_state.player_to_move == AI:
        best_val = -float("inf")
        alpha, beta = -float("inf"), float("inf")
        for mv in root_state.legal_moves():
            child_state = root_state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=root, depth=1)
            root.children.append(child)

            val = min_value(child, depth_limit - 1, alpha, beta)
            if val > best_val:
                best_val = val
                best_move = mv
            alpha = max(alpha, best_val)
        root.value = best_val
    else:
        best_val = float("inf")
        alpha, beta = -float("inf"), float("inf")
        for mv in root_state.legal_moves():
            child_state = root_state.apply(mv)
            child = Node(state=child_state, move_from_parent=mv, parent=root, depth=1)
            root.children.append(child)

            val = max_value(child, depth_limit - 1, alpha, beta)
            if val < best_val:
                best_val = val
                best_move = mv
            beta = min(beta, best_val)
        root.value = best_val

    if best_move is None:
        best_move = Move(2)  # Fallback (shouldn't happen in normal play)

    return best_move, root, stats


# -----------------------------
# Random start numbers (multiples of 6)
# -----------------------------

def generate_start_numbers(k: int = 5, low: int = 10000, high: int = 20000, seed: Optional[int] = None) -> List[int]:
    if seed is not None:
        random.seed(seed)

    nums = set()
    while len(nums) < k:
        x = random.randint(low, high)
        x -= (x % 6)  # snap down to multiple of 6
        if x < low:
            continue
        nums.add(x)
    return sorted(nums)


# -----------------------------
# Experiments (10 games per algorithm)
# - "human" is simulated as random legal move.
# - AI uses selected algorithm.
# - Collect: wins, generated/evaluated nodes, avg AI move time.
# -----------------------------

def play_game_simulated(start_n: int, algo: str, depth_limit: int, seed: int) -> dict:
    rnd = random.Random(seed)
    state = GameState(start_n, 0, 0, HUMAN)  # simulated human starts by default in experiments

    total_ai_time = 0.0
    ai_moves = 0
    total_generated = 0
    total_evaluated = 0

    while not state.is_terminal():
        moves = state.legal_moves()
        if not moves:
            break

        if state.player_to_move == HUMAN:   
            mv = rnd.choice(moves)
            state = state.apply(mv)
        else:
            t0 = time.perf_counter()
            if algo == "minimax":
                mv, _, st = minimax_decision(state, depth_limit)
            else:
                mv, _, st = alphabeta_decision(state, depth_limit)
            dt = time.perf_counter() - t0

            total_ai_time += dt
            ai_moves += 1
            total_generated += st.generated_nodes
            total_evaluated += st.evaluated_nodes

            state = state.apply(mv)

    winner = state.winner()
    return {
        "start_n": start_n,
        "algo": algo,
        "depth": depth_limit,
        "winner": "draw" if winner is None else ("human" if winner == HUMAN else "ai"),
        "final_n": state.n,
        "human_score": state.score_human,
        "ai_score": state.score_ai,
        "ai_move_time_avg": (total_ai_time / ai_moves) if ai_moves else 0.0,
        "generated_nodes_total": total_generated,
        "evaluated_nodes_total": total_evaluated,
        "ai_moves": ai_moves,
    }


def run_experiments(depth_limit: int = 8, games_per_algo: int = 10) -> List[dict]:
    results = []
    base_seed = 12345
    # Use fresh start numbers for each game, but deterministic for report
    starts = [generate_start_numbers(seed=base_seed + i)[0] for i in range(games_per_algo)]

    for algo in ("minimax", "alphabeta"):
        for i in range(games_per_algo):
            res = play_game_simulated(
                start_n=starts[i],
                algo=algo,
                depth_limit=depth_limit,
                seed=base_seed + 1000 + i
            )
            results.append(res)
    return results


