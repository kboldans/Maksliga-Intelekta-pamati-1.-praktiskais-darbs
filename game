    def _refresh_start_numbers_ui(self):
        for w in self.numbers_frame.winfo_children():
            w.destroy()
        for x in self.start_numbers:
            ttk.Radiobutton(self.numbers_frame, text=str(x), variable=self.selected_start, value=x).pack(side=tk.LEFT, padx=6)

    def _regen_numbers(self):
        self.start_numbers = generate_start_numbers()
        self.selected_start.set(self.start_numbers[0])
        self._refresh_start_numbers_ui()
        self._set_status("Saģenerēti jauni sākuma skaitļi.")

    def _start_game(self):
        n0 = int(self.selected_start.get())
        starter = HUMAN if self.first_player.get() == "human" else AI
        self.state = GameState(n0, 0, 0, starter)
        self.last_tree_root = None
        self.last_stats = None
        self._update_ui_from_state()
        self._log_ai("Jauna spēle sākta.\n")

        if self.state.player_to_move == AI:
            self.after(100, self._ai_move)

    def _update_ui_from_state(self):
        if not self.state:
            return
        self.lbl_n.config(text=f"n = {self.state.n}")
        self.lbl_scores.config(text=f"Cilvēks: {self.state.score_human} | Dators: {self.state.score_ai}")
        who = "Cilvēks" if self.state.player_to_move == HUMAN else "Dators"
        self.lbl_turn.config(text=f"Gājiens: {who}")

        legal = {mv.divisor for mv in self.state.legal_moves()}
        self.btn_div2.config(state=("normal" if (2 in legal and self.state.player_to_move == HUMAN and not self.state.is_terminal()) else "disabled"))
        self.btn_div3.config(state=("normal" if (3 in legal and self.state.player_to_move == HUMAN and not self.state.is_terminal()) else "disabled"))

        if self.state.is_terminal():
            self.btn_div2.config(state="disabled")
            self.btn_div3.config(state="disabled")
            self._announce_result()

    def _announce_result(self):
        if not self.state:
            return
        w = self.state.winner()
        reason = self.state.terminal_reason()
        if reason == "number_reached":
            prefix = f"Game over: reached number {self.state.n} (<= 10)."
        else:
            prefix = f"Game over: no legal moves remain at {self.state.n}."
        if w is None:
            msg = f"{prefix}\nDraw.\nScore: {self.state.score_human}:{self.state.score_ai}"
        elif w == HUMAN:
            msg = f"{prefix}\nHuman wins.\nScore: {self.state.score_human}:{self.state.score_ai}"
        else:
            msg = f"{prefix}\nComputer wins.\nScore: {self.state.score_human}:{self.state.score_ai}"
        self._set_status(msg)
        messagebox.showinfo("Result", msg)
        return
        if not self.state:
            return
        w = self.state.winner()
        if w is None:
            msg = f"Spēle beigusies: NEIZŠĶIRTS.\nRezultāts: {self.state.score_human}:{self.state.score_ai}"
        elif w == HUMAN:
            msg = f"Spēle beigusies: UZVAR CILVĒKS.\nRezultāts: {self.state.score_human}:{self.state.score_ai}"
        else:
            msg = f"Spēle beigusies: UZVAR DATORS.\nRezultāts: {self.state.score_human}:{self.state.score_ai}"
        self._set_status(msg)
        messagebox.showinfo("Rezultāts", msg)

    def _human_move(self, divisor: int):
        if not self.state:
            return
        if self.state.player_to_move != HUMAN:
            self._set_status("It is currently the computer's turn.")
            return
        if self.state.is_terminal():
            self._announce_result()
            return
        if self.state.n % divisor != 0:
            self._set_status(f"Illegal move: {self.state.n} is not divisible by {divisor}.")
            messagebox.showwarning("Illegal move", f"{self.state.n} is not divisible by {divisor}.")
            return
        self.state = self.state.apply(Move(divisor))
        self._update_ui_from_state()
        if self.state and not self.state.is_terminal() and self.state.player_to_move == AI:
            self.after(100, self._ai_move)
        return
        if not self.state or self.state.player_to_move != HUMAN or self.state.is_terminal():
            return
        mv = Move(divisor)
        if self.state.n % divisor != 0:
            return
        self.state = self.state.apply(mv)
        self._update_ui_from_state()
        if self.state and not self.state.is_terminal() and self.state.player_to_move == AI:
            self.after(100, self._ai_move)

    def _skip_turn_if_no_moves(self):
        if not self.state or self.state.is_terminal():
            return
        if not self.state.can_move():
            self._set_status(f"No legal moves remain at {self.state.n}.")
            self._update_ui_from_state()
        return
        """Skip current player's turn if they have no legal moves."""
        if not self.state or self.state.is_terminal():
            return
        if not self.state.can_move():
            # Current player has no moves, pass to other player
            self.state = GameState(self.state.n, self.state.score_human, self.state.score_ai, 
                                   AI if self.state.player_to_move == HUMAN else HUMAN)
            self._update_ui_from_state()
            if self.state and not self.state.is_terminal() and self.state.player_to_move == AI:
                self.after(100, self._ai_move)

    def _ai_move(self):
        if not self.state or self.state.player_to_move != AI or self.state.is_terminal():
            return
        if not self.state.can_move():
            self._log_ai(f"AI cannot move at {self.state.n}: no legal moves remain.\n")
            self._skip_turn_if_no_moves()
            return
        if not self.state or self.state.player_to_move != AI or self.state.is_terminal():
            return
        
        # Skip AI turn if no moves available
        if not self.state.can_move():
            self._skip_turn_if_no_moves()
            return
        
        algo = self.algorithm.get()
        depth = int(self.depth_limit.get())

        t0 = time.perf_counter()
        if algo == "minimax":
            mv, root, stats = minimax_decision(self.state, depth)
        else:
            mv, root, stats = alphabeta_decision(self.state, depth)
        dt = time.perf_counter() - t0

        self.last_tree_root = root
        self.last_stats = stats

        self._log_ai(
            f"AI gājiens: dalīt ar {mv.divisor}\n"
            f"Algoritms: {algo}, dziļums: {depth}\n"
            f"Laiks: {dt:.4f}s\n"
            f"Ģenerētās virsotnes: {stats.generated_nodes}\n"
            f"Novērtētās virsotnes: {stats.evaluated_nodes}\n"
            f"Saknes vērtība: {root.value}\n"
            f"{'-'*40}\n"
        )

        self.state = self.state.apply(mv)
        self._update_ui_from_state()

    def _log_ai(self, text: str):
        self.txt_ai.insert("end", text)
        self.txt_ai.see("end")

    def _set_status(self, text: str):
        self.lbl_status.config(text=text)

    def _run_experiments_ui(self):
        depth = int(self.depth_limit.get())
        results = run_experiments(depth_limit=depth, games_per_algo=10)

        # Summarize
        summary = {"minimax": {"ai": 0, "human": 0, "draw": 0, "t": 0.0, "k": 0},
                   "alphabeta": {"ai": 0, "human": 0, "draw": 0, "t": 0.0, "k": 0}}

        for r in results:
            s = summary[r["algo"]]
            s[r["winner"]] += 1
            s["t"] += r["ai_move_time_avg"]
            s["k"] += 1

        msg = (
            f"Eksperimenti pabeigti (dziļums {depth}).\n\n"
            f"Minimax: AI uzvaras={summary['minimax']['ai']}, Cilvēks={summary['minimax']['human']}, Neizšķirti={summary['minimax']['draw']}, "
            f"AI vid. gājiena laiks={summary['minimax']['t']/summary['minimax']['k']:.4f}s\n"
            f"Alpha–Beta: AI uzvaras={summary['alphabeta']['ai']}, Cilvēks={summary['alphabeta']['human']}, Neizšķirti={summary['alphabeta']['draw']}, "
            f"AI vid. gājiena laiks={summary['alphabeta']['t']/summary['alphabeta']['k']:.4f}s\n\n"
            f"(Cilvēks eksperimentos ir simulēts ar random legālu gājienu.)"
        )
        self._log_ai("\n" + msg + "\n" + "="*40 + "\n")
        messagebox.showinfo("Eksperimentu kopsavilkums", msg)


def main():
    app = GameApp()
    app.mainloop()


if __name__ == "__main__":
    main()
